# Optional: set SMTP_* in .env if you use workSphere email invites (see server/index.js).

# Share invite/join links with a phone on the same Wi‑Fi: use your PC's LAN IP + Vite port (not localhost).
# Example after `ipconfig` (Windows) or `ip addr`: http://192.168.1.42:5173
# Must match what you put in the browser when copying links. Restart `npm run dev` after changing.
VITE_PUBLIC_APP_URL=
# Same value for email invite links built on the server (optional if only VITE_ is in .env — server also reads VITE_PUBLIC_APP_URL).
PUBLIC_APP_URL=

# If the phone times out, allow inbound TCP 5173 on Windows (Administrator PowerShell):
# netsh advfirewall firewall add rule name="Vite workSphere 5173" dir=in action=allow protocol=TCP localport=5173
