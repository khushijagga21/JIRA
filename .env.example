# OpenAI — powers the workSphere AI assistant (floating chat widget).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional model (default: gpt-4o-mini). Vision + chat: gpt-4o-mini, gpt-4o
OPENAI_MODEL=gpt-4o-mini

# Optional: set SMTP_* in .env if you use workSphere email invites (see server/index.js).

# Production: URL of the deployed Express API (required for Vercel/Netlify frontend-only deploys).
# Example: https://worksphere-api.onrender.com
VITE_API_URL=

# Server only (Render/Fly/Railway/etc.): override where SQLite + uploads live.
# On Render this should be the mount path of the persistent disk, e.g. /var/data.
# Leave empty for local dev (defaults to ./server/).
WORKSPHERE_DATA_DIR=

# Share invite/join links with a phone on the same Wi‑Fi: use your PC's LAN IP + Vite port (not localhost).
# Example after `ipconfig` (Windows) or `ip addr`: http://192.168.1.42:5173
# Must match what you put in the browser when copying links. Restart `npm run dev` after changing.
VITE_PUBLIC_APP_URL=
# Same value for email invite links built on the server (optional if only VITE_ is in .env — server also reads VITE_PUBLIC_APP_URL).
PUBLIC_APP_URL=

# If the phone cannot open invite links, allow inbound TCP on Windows (Administrator PowerShell):
# netsh advfirewall firewall add rule name="workSphere web 5173" dir=in action=allow protocol=TCP localport=5173
# netsh advfirewall firewall add rule name="workSphere API 8787" dir=in action=allow protocol=TCP localport=8787
