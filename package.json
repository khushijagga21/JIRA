{
  "name": "jira-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -n api,web -c green,cyan --restart-tries 2 --restart-after 2000 \"node server/index.js\" \"vite --host\"",
    "dev:restart": "node scripts/free-api-port.mjs && npm run dev",
    "rebuild:sqlite": "npm rebuild better-sqlite3",
    "dev:web": "vite --host",
    "dev:full": "concurrently -n api,web -c green,cyan \"node server/index.js\" \"vite --host\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview --host",
    "postinstall": "npm rebuild better-sqlite3"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21",
    "@monaco-editor/react": "^4.7.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "monaco-editor": "^0.55.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.4"
  }
}
